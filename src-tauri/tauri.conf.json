{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rhm2sspm",
  "version": "0.1.1",
  "identifier": "com.rhmtosspm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "rhm2sspm — Rhythia ⇄ Sound Space+",
        "width": 980,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzQUZEMEUxQ0IzQjc0RTAKUldUZ2REdkw0ZEN2azJZeUg0UmV2YjlDY1M4M1AvY3VuSGlEcjZMdll0ZExiMmdPUGR1SEZqVnAK",
      "endpoints": [
        "https://github.com/gerhaarrd/rhm2sspm/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis", "msi"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "fileAssociations": [
      {
        "ext": ["rhm"],
        "name": "Rhythia Map",
        "description": "Rhythia map file",
        "role": "Editor"
      },
      {
        "ext": ["phxm"],
        "name": "Rhythia Map (rewrite)",
        "description": "Rhythia rewrite-client map file",
        "role": "Editor"
      },
      {
        "ext": ["npk"],
        "name": "Nova Map",
        "description": "Nova map file",
        "role": "Editor"
      },
      {
        "ext": ["sspm"],
        "name": "Sound Space+ Map",
        "description": "Sound Space+ map file",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
